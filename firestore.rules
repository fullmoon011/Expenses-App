rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidUserBackup(data) {
      return data.keys().hasAll(['ownerId', 'workspaceName', 'payload', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'workspaceName', 'payload', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId == request.auth.uid
        && data.workspaceName is string
        && data.workspaceName.size() >= 1
        && data.workspaceName.size() <= 100
        && data.payload is string
        && data.payload.size() >= 2
        && data.payload.size() <= 900000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /backups/{backupId} {
      allow get: if isSignedIn()
        && isValidId(backupId)
        && existing().ownerId == request.auth.uid;

      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(backupId)
        && isValidUserBackup(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(backupId)
        && isValidUserBackup(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['workspaceName', 'payload', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(backupId)
        && existing().ownerId == request.auth.uid;
    }

    function isValidSharedWorkspace(data) {
      return data.keys().hasAll(['ownerId', 'workspaceName', 'payload', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'workspaceName', 'payload', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.workspaceName is string
        && data.workspaceName.size() >= 1
        && data.workspaceName.size() <= 100
        && data.payload is string
        && data.payload.size() >= 2
        && data.payload.size() <= 900000
        && data.updatedBy is string
        && data.updatedBy.size() >= 1
        && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /shared_workspaces/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);

      allow create: if isSignedIn()
        && isValidId(inviteCode)
        && isValidSharedWorkspace(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(inviteCode)
        && isValidSharedWorkspace(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['workspaceName', 'payload', 'updatedBy', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(inviteCode)
        && existing().ownerId == request.auth.uid;
    }
  }
}
